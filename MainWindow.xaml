<Window x:Class="StoryForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StoryForge — MCSM Launcher"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Storyboard x:Key="PageFadeIn">
            <DoubleAnimation Storyboard.TargetName="ContentFrame"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22"/>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40"
                              ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="20,22,20,18"
                                MouseLeftButtonDown="TopBar_MouseDown"
                                Cursor="SizeAll">
                        <TextBlock Text="StoryForge"
                                   Foreground="{StaticResource GoldBrush}"
                                   FontFamily="pack://application:,,,/Assets/#Minecraft"
                                   FontSize="18">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#f5a623" BlurRadius="14"
                                                  ShadowDepth="0" Opacity="0.45"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="MCSM Launcher"
                                   Foreground="{StaticResource Muted2Brush}"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Rectangle Grid.Row="0" VerticalAlignment="Bottom"
                               Height="1" Fill="{StaticResource BorderBrush}"
                               Margin="16,0"/>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">

                        <Button x:Name="BtnHome"
                                Style="{StaticResource SideNavButton}"
                                Click="Nav_Home" Height="44">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂" FontSize="14" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Home" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSaves"
                                Style="{StaticResource SideNavButton}"
                                Click="Nav_Saves">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="13" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Save Files" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnMods"
                                Style="{StaticResource SideNavButton}"
                                Click="Nav_Mods">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧩" FontSize="13" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Mods" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSettings"
                                Style="{StaticResource SideNavButton}"
                                Click="Nav_Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="14" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnAbout"
                                Style="{StaticResource SideNavButton}"
                                Click="Nav_About">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ" FontSize="14" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="About" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="20,0,20,16">
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="VersionLabel"
                                   Text="v1.2.1"
                                   Foreground="{StaticResource Muted2Brush}"
                                   FontFamily="Segoe UI"
                                   FontSize="10"/>
                        <TextBlock Text="by B0zin0"
                                   Foreground="{StaticResource Muted2Brush}"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Rectangle Grid.Column="1"
                       Fill="{StaticResource BorderBrush}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="TopBar_MouseDown">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Button Click="Discord_Click" Cursor="Hand"
                                Background="Transparent" BorderThickness="0"
                                Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#5865F2"
                                            CornerRadius="14" Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                                <Path Fill="White"
                                                      Data="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.032.054a19.97 19.97 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
                                            </Viewbox>
                                            <TextBlock Text="Join our community!"
                                                       Foreground="White"
                                                       FontFamily="Segoe UI"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Click="YouTube_Click" Cursor="Hand"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#FF0000"
                                            CornerRadius="14" Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                                <Path Fill="White" Data="M8 5v14l11-7z"/>
                                            </Viewbox>
                                            <TextBlock Text="subscribe to my channel for more updates!"
                                                       Foreground="White"
                                                       FontFamily="Segoe UI"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0">
                        <Button Content="—"
                                Style="{StaticResource ChromeButton}"
                                Click="Minimize_Click"/>
                        <Button Content="✕"
                                Style="{StaticResource CloseButton}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="UpdateBanner"
                        Grid.Row="1"
                        Background="#1a1400"
                        BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="Collapsed"
                        Cursor="Hand"
                        Margin="12,0,12,0"
                        CornerRadius="8"
                        MouseLeftButtonDown="UpdateBanner_Click">
                    <Grid Margin="14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource Gold2Brush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="UPDATE"
                                       Foreground="#0f0f17"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       FontSize="9"/>
                        </Border>
                        <TextBlock x:Name="UpdateLabel"
                                   Grid.Column="1"
                                   Foreground="{StaticResource GoldBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Frame x:Name="ContentFrame"
                       Grid.Row="2"
                       Background="Transparent"
                       NavigationUIVisibility="Hidden"
                       Opacity="1"/>
            </Grid>
        </Grid>
    </Border>
</Window>
