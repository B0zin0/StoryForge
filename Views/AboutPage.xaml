<Page x:Class="StoryForge.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20">
        <StackPanel MaxWidth="680">

            <TextBlock Text="About StoryForge"
                       Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Open-source launcher and mod manager for Minecraft: Story Mode."
                       Style="{StaticResource McLabel}"
                       Margin="0,0,0,24"/>

            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="StoryForge"
                                   Foreground="{StaticResource GoldBrush}"
                                   FontFamily="pack://application:,,,/Assets/#Minecraft"
                                   FontSize="28">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#f5a623" BlurRadius="16"
                                                  ShadowDepth="0" Opacity="0.4"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="MCSM Launcher  ·  Open Beta"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{StaticResource Surface3Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,8"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="VersionBadge"
                                   Text="v1.2.0"
                                   Foreground="{StaticResource GoldBrush}"
                                   FontFamily="Segoe UI"
                                   FontWeight="Bold"
                                   FontSize="13"/>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,14">
                <ItemsControl x:Name="InfoItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontFamily="Segoe UI"
                                           FontSize="11"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource Muted2Brush}"
                           FontFamily="Segoe UI" FontSize="11"
                           Text="StoryForge is an open-source fan project. It is not affiliated with, endorsed by, or sponsored by Telltale Games, Mojang, or Microsoft. Minecraft: Story Mode and all related names are trademarks of their respective owners."/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
