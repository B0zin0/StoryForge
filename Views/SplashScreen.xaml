<Window x:Class="StoryForge.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Topmost="True">

    <Window.Resources>
        <Storyboard x:Key="FadeOut" Completed="FadeOut_Completed">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.35"/>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="Root"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40"
                              ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>

        <Grid Margin="36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="StoryForge"
                       Foreground="{StaticResource GoldBrush}"
                       FontFamily="pack://application:,,,/Assets/#Minecraft"
                       FontSize="32"
                       HorizontalAlignment="Left">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#f5a623" BlurRadius="18"
                                      ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Grid.Row="1"
                       Text="MCSM Launcher"
                       Foreground="{StaticResource MutedBrush}"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Margin="2,4,0,0"/>

            <TextBlock x:Name="VersionText"
                       Grid.Row="2"
                       Text="v1.2.0"
                       Foreground="{StaticResource Muted2Brush}"
                       FontFamily="Segoe UI"
                       FontSize="10"
                       Margin="2,2,0,0"/>

            <Border Grid.Row="4"
                    Height="4"
                    Background="{StaticResource Surface3Brush}"
                    CornerRadius="2"
                    Margin="0,0,0,8">
                <Border x:Name="ProgressFill"
                        HorizontalAlignment="Left"
                        CornerRadius="2"
                        Width="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#d4881a" Offset="0"/>
                            <GradientStop Color="#f5a623" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#f5a623" BlurRadius="8"
                                          ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
            </Border>

            <TextBlock x:Name="StatusLabel"
                       Grid.Row="5"
                       Text="Initializing..."
                       Foreground="{StaticResource MutedBrush}"
                       FontFamily="Segoe UI"
                       FontSize="10"/>
        </Grid>
    </Border>
</Window>
