<Page x:Class="StoryForge.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20">
        <StackPanel MaxWidth="680">

            <TextBlock Text="Settings"
                       Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Configure paths, audio, and window preferences."
                       Style="{StaticResource McLabel}"
                       Margin="0,0,0,24"/>

            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Game Paths"
                               Foreground="{StaticResource TextBrush}"
                               FontFamily="Segoe UI" FontWeight="SemiBold"
                               FontSize="13" Margin="0,0,0,14"/>

                    <Button Content="Auto-Detect Game Paths"
                            Style="{StaticResource GoldButton}"
                            HorizontalAlignment="Stretch"
                            Padding="0,10" FontSize="12"
                            Margin="0,0,0,8"
                            Click="AutoDetect_Click"/>

                    <TextBlock x:Name="DetectLabel" Text=""
                               Foreground="{StaticResource GreenBrush}"
                               FontFamily="Segoe UI" FontSize="11"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="Season 1 .exe" Style="{StaticResource McLabel}"
                               Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="S1PathBox" Grid.Column="0"
                                 Style="{StaticResource McTextBox}"/>
                        <Button Content="Browse" Grid.Column="1"
                                Style="{StaticResource McButton}"
                                Padding="12,8" Margin="8,0,0,0"
                                Click="Browse_S1"/>
                    </Grid>

                    <TextBlock Text="Season 2 .exe" Style="{StaticResource McLabel}"
                               Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="S2PathBox" Grid.Column="0"
                                 Style="{StaticResource McTextBox}"/>
                        <Button Content="Browse" Grid.Column="1"
                                Style="{StaticResource McButton}"
                                Padding="12,8" Margin="8,0,0,0"
                                Click="Browse_S2"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Audio"
                               Foreground="{StaticResource TextBrush}"
                               FontFamily="Segoe UI" FontWeight="SemiBold"
                               FontSize="13" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="MusicCheck" Grid.Column="0"
                                  Content="Background music"
                                  Foreground="{StaticResource MutedBrush}"
                                  FontFamily="Segoe UI" FontSize="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  Checked="Music_Changed"
                                  Unchecked="Music_Changed"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="1"
                                Minimum="0" Maximum="1"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="Volume_Changed"/>
                        <TextBlock x:Name="VolumeLabel" Grid.Column="2"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontFamily="Segoe UI" FontSize="11"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Performance"
                               Foreground="{StaticResource TextBrush}"
                               FontFamily="Segoe UI" FontWeight="SemiBold"
                               FontSize="13" Margin="0,0,0,12"/>
                    <CheckBox x:Name="KillAppsCheck"
                              Content="Close background apps before launching"
                              Foreground="{StaticResource MutedBrush}"
                              FontFamily="Segoe UI" FontSize="12"
                              Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{StaticResource Muted2Brush}"
                               FontFamily="Segoe UI" FontSize="11"
                               Text="Closes Spotify, Chrome, Discord, and other background apps when launching MCSM to free up RAM. They won't restart automatically."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Window Size"
                               Foreground="{StaticResource TextBrush}"
                               FontFamily="Segoe UI" FontWeight="SemiBold"
                               FontSize="13" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="900×600"   Style="{StaticResource McButton}"
                                Padding="12,7" Margin="0,0,8,0" Click="Preset_900"/>
                        <Button Content="1280×720"  Style="{StaticResource McButton}"
                                Padding="12,7" Margin="0,0,8,0" Click="Preset_1280"/>
                        <Button Content="1600×900"  Style="{StaticResource McButton}"
                                Padding="12,7" Margin="0,0,8,0" Click="Preset_1600"/>
                        <Button Content="Fullscreen" Style="{StaticResource GoldButton}"
                                Padding="12,7" Click="Preset_Full"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="Save Settings" Style="{StaticResource GoldButton}"
                        Padding="20,10" Click="Save_Click"/>
                <TextBlock x:Name="SavedLabel" Text=""
                           Foreground="{StaticResource GreenBrush}"
                           FontFamily="Segoe UI" FontSize="12"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
