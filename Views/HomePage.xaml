<Page x:Class="StoryForge.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">

    <Page.Resources>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"            Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderThickness"       Value="1"/>
            <Setter Property="CornerRadius"          Value="12"/>
            <Setter Property="Cursor"                Value="Hand"/>
            <Setter Property="Width"                 Value="290"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        </Style>

        <Storyboard x:Key="CardsIn">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S1Scale"
                                          Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0" Value="0.85"/>
                <EasingDoubleKeyFrame   KeyTime="0:0:0.35" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S1Scale"
                                          Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0" Value="0.85"/>
                <EasingDoubleKeyFrame   KeyTime="0:0:0.35" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="S1Border"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S2Scale"
                                          Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="0.85"/>
                <EasingDoubleKeyFrame   KeyTime="0:0:0.47" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="S2Scale"
                                          Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="0.85"/>
                <EasingDoubleKeyFrame   KeyTime="0:0:0.47" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="S2Border"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             BeginTime="0:0:0.12" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="S1GlowOn">
            <ColorAnimation Storyboard.TargetName="S1Border"
                            Storyboard.TargetProperty="BorderBrush.Color"
                            To="#a855f7" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="S1Glow"
                             Storyboard.TargetProperty="BlurRadius"
                             To="32" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="S1GlowOff">
            <ColorAnimation Storyboard.TargetName="S1Border"
                            Storyboard.TargetProperty="BorderBrush.Color"
                            To="#2a2a3a" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="S1Glow"
                             Storyboard.TargetProperty="BlurRadius"
                             To="0" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="S2GlowOn">
            <ColorAnimation Storyboard.TargetName="S2Border"
                            Storyboard.TargetProperty="BorderBrush.Color"
                            To="#2dd4bf" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="S2Glow"
                             Storyboard.TargetProperty="BlurRadius"
                             To="32" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="S2GlowOff">
            <ColorAnimation Storyboard.TargetName="S2Border"
                            Storyboard.TargetProperty="BorderBrush.Color"
                            To="#2a2a3a" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="S2Glow"
                             Storyboard.TargetProperty="BlurRadius"
                             To="0" Duration="0:0:0.2"/>
        </Storyboard>

    </Page.Resources>

    <Grid>
        <MediaElement x:Name="BgVideo"
                      Source="Assets/bg_video.mp4"
                      IsMuted="True"
                      Stretch="UniformToFill"
                      LoadedBehavior="Manual"
                      MediaEnded="BgVideo_Ended"/>

        <Rectangle Fill="#88000000"/>

        <Viewbox Stretch="Uniform">
            <StackPanel Width="880" Height="640"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="Select Season"
                           Foreground="{StaticResource GoldBrush}"
                           FontFamily="pack://application:,,,/Assets/#Minecraft"
                           FontSize="22"
                           HorizontalAlignment="Center"
                           Margin="0,60,0,40">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#f5a623" BlurRadius="16"
                                          ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Border x:Name="S1Border"
                            Style="{StaticResource CardBorder}"
                            BorderBrush="{StaticResource BorderBrush}"
                            Margin="0,0,40,0" Opacity="0"
                            SizeChanged="Card_SizeChanged"
                            MouseEnter="S1_Enter" MouseLeave="S1_Leave"
                            MouseLeftButtonDown="S1_Click">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="S1Scale" ScaleX="0.85" ScaleY="0.85"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="S1Glow" Color="#a855f7"
                                              BlurRadius="0" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                        <StackPanel>
                            <Image x:Name="S1Image" Height="380" Stretch="UniformToFill"/>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    Padding="0,14">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="SEASON 1"
                                               Foreground="{StaticResource GoldBrush}"
                                               FontFamily="pack://application:,,,/Assets/#Minecraft"
                                               FontSize="13"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click to launch"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontFamily="Segoe UI"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="S2Border"
                            Style="{StaticResource CardBorder}"
                            BorderBrush="{StaticResource BorderBrush}"
                            Opacity="0"
                            SizeChanged="Card_SizeChanged"
                            MouseEnter="S2_Enter" MouseLeave="S2_Leave"
                            MouseLeftButtonDown="S2_Click">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="S2Scale" ScaleX="0.85" ScaleY="0.85"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="S2Glow" Color="#2dd4bf"
                                              BlurRadius="0" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                        <StackPanel>
                            <Image x:Name="S2Image" Height="380" Stretch="UniformToFill"/>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    Padding="0,14">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="SEASON 2"
                                               Foreground="{StaticResource TealBrush}"
                                               FontFamily="pack://application:,,,/Assets/#Minecraft"
                                               FontSize="13"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click to launch"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontFamily="Segoe UI"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </Viewbox>
    </Grid>
</Page>
