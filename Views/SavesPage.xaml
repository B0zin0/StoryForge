<Page x:Class="StoryForge.Views.SavesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20">
        <StackPanel MaxWidth="760">

            <TextBlock Text="Save Files"
                       Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Back up, export, and restore your MCSM save data."
                       Style="{StaticResource McLabel}"
                       Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="#6b6b85"
                       FontFamily="Segoe UI" FontSize="11"
                       Margin="0,0,0,22"
                       Text="⚠  StoryForge automatically backs up your existing save before any import. Still — export first if in doubt."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Season 1"
                                       Foreground="{StaticResource GoldBrush}"
                                       FontFamily="pack://application:,,,/Assets/#Minecraft"
                                       FontSize="13"/>
                            <Border Grid.Column="1"
                                    x:Name="S1Badge"
                                    Background="{StaticResource Surface3Brush}"
                                    CornerRadius="12"
                                    Padding="8,3">
                                <TextBlock x:Name="S1FileCount"
                                           Text="—"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="S1SavePath"
                                   Text="Searching..."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontFamily="Segoe UI" FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <Border x:Name="S1FileList"
                                Background="{StaticResource BgBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,14"
                                MinHeight="60">
                            <ItemsControl x:Name="S1Files">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="Segoe UI Mono, Consolas"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Button Content="Export Save"
                                Style="{StaticResource GoldButton}"
                                HorizontalAlignment="Stretch"
                                Padding="0,9"
                                Margin="0,0,0,8"
                                Click="ExportS1_Click"/>
                        <Button Content="Import Save"
                                Style="{StaticResource McButton}"
                                HorizontalAlignment="Stretch"
                                Padding="0,9"
                                Click="ImportS1_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Season 2"
                                       Foreground="{StaticResource TealBrush}"
                                       FontFamily="pack://application:,,,/Assets/#Minecraft"
                                       FontSize="13"/>
                            <Border Grid.Column="1"
                                    x:Name="S2Badge"
                                    Background="{StaticResource Surface3Brush}"
                                    CornerRadius="12"
                                    Padding="8,3">
                                <TextBlock x:Name="S2FileCount"
                                           Text="—"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="S2SavePath"
                                   Text="Searching..."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontFamily="Segoe UI" FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <Border Background="{StaticResource BgBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,14"
                                MinHeight="60">
                            <ItemsControl x:Name="S2Files">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="Segoe UI Mono, Consolas"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Button Content="Export Save"
                                Style="{StaticResource GoldButton}"
                                HorizontalAlignment="Stretch"
                                Padding="0,9"
                                Margin="0,0,0,8"
                                Click="ExportS2_Click"/>
                        <Button Content="Import Save"
                                Style="{StaticResource McButton}"
                                HorizontalAlignment="Stretch"
                                Padding="0,9"
                                Click="ImportS2_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="StatusBar"
                    Margin="0,16,0,0"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Visibility="Collapsed">
                <TextBlock x:Name="StatusLabel"
                           Foreground="{StaticResource GreenBrush}"
                           FontFamily="Segoe UI" FontSize="12"
                           HorizontalAlignment="Center"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
