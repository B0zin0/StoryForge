<Window x:Class="StoryForge.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Topmost="True">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40"
                              ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>

        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Background="#3b1a1a"
                        BorderBrush="#7f1d1d"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="ERROR"
                               Foreground="{StaticResource RedBrush}"
                               FontFamily="Segoe UI"
                               FontWeight="Bold"
                               FontSize="10"/>
                </Border>
                <TextBlock Text="StoryForge"
                           Foreground="{StaticResource MutedBrush}"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Foreground="{StaticResource TextBrush}"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       LineHeight="20"/>

            <Button Grid.Row="2"
                    Content="OK"
                    Style="{StaticResource McButton}"
                    HorizontalAlignment="Right"
                    Padding="28,8"
                    Margin="0,14,0,0"
                    Click="Ok_Click"/>
        </Grid>
    </Border>
</Window>
