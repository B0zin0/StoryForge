<Page x:Class="StoryForge.Views.SavesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Black">

    <Grid>
        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource Gold2Brush}"
                BorderThickness="2"
                Width="700"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="32,28">
            <StackPanel>

                <TextBlock Text="SAVE FILES"
                           Foreground="{StaticResource GoldBrush}"
                           FontFamily="/Assets/#Minecraft"
                           FontSize="18"
                           HorizontalAlignment="Center"/>

                <Rectangle Height="2" Fill="{StaticResource GoldBrush}" Margin="0,8,0,4"/>

                <TextBlock Text="Made by B0zin0  —  StoryForge Save Manager"
                           Foreground="{StaticResource GrayBrush}"
                           FontFamily="Segoe UI" FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource GrayBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           Margin="0,0,0,20"
                           Text="Back up your saves before importing anything. Once you import a save it overwrites your current one — StoryForge backs up the old one automatically but still, be careful."/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0D0D0D"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Padding="16,14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="SEASON 1"
                                       Foreground="{StaticResource GoldBrush}"
                                       FontFamily="/Assets/#Minecraft"
                                       FontSize="11" Margin="0,0,0,8"/>
                            <TextBlock x:Name="S1SaveInfo"
                                       Foreground="{StaticResource GrayBrush}"
                                       FontFamily="Segoe UI" FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       Text="Looking for saves..."/>
                            <Button Content="Export Save"
                                    Style="{StaticResource GoldButton}"
                                    Margin="0,0,0,6"
                                    Click="ExportS1_Click"/>
                            <Button Content="Import Save"
                                    Style="{StaticResource McButton}"
                                    Click="ImportS1_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#0D0D0D"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Padding="16,14" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="SEASON 2"
                                       Foreground="{StaticResource GoldBrush}"
                                       FontFamily="/Assets/#Minecraft"
                                       FontSize="11" Margin="0,0,0,8"/>
                            <TextBlock x:Name="S2SaveInfo"
                                       Foreground="{StaticResource GrayBrush}"
                                       FontFamily="Segoe UI" FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       Text="Looking for saves..."/>
                            <Button Content="Export Save"
                                    Style="{StaticResource GoldButton}"
                                    Margin="0,0,0,6"
                                    Click="ExportS2_Click"/>
                            <Button Content="Import Save"
                                    Style="{StaticResource McButton}"
                                    Click="ImportS2_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="StatusLabel"
                           Foreground="{StaticResource GreenBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"
                           Text=""/>

                <Button Content="BACK"
                        Style="{StaticResource McButton}"
                        HorizontalAlignment="Center"
                        Click="Back_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
